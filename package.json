{
  "name": "draftsman",
  "version": "0.0.0",
  "description": "Takes a markdown draft to a publish-ready post, driven by the AI you already use. A local MCP server; calls no model.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "draftsman": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-browser": "tsx scripts/install-test-browser.ts",
    "check-names": "bash scripts/check-private-names.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "puppeteer-core": "25.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@puppeteer/browsers": "3.3.0",
    "@types/node": "24.19.4",
    "@types/pngjs": "6.0.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
